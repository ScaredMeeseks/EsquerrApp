rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    // Claims-only authorization (Phase 3b): Auth custom claims are set by
    // joinClub/setRole (backfilled 2026-07-10) and refresh with the ID
    // token, so every live session has them. The Phase-2 users-doc
    // fallback (`me()`) is gone — no per-request document reads.
    function isSuperUser() {
      return request.auth != null && request.auth.token.email == 'marna96@gmail.com';
    }
    function sameTeam(teamId) {
      return request.auth != null && request.auth.token.teamId == teamId;
    }
    function isStaffOf(teamId) {
      return request.auth != null
        && request.auth.token.teamId == teamId
        && request.auth.token.role in ['staff', 'lead'];
    }
    function isLeadOf(teamId) {
      return request.auth != null
        && request.auth.token.teamId == teamId
        && request.auth.token.role == 'lead';
    }
    // Per-record ownership: doc ids are "{uid}" or "{uid}_..."
    function owns(docId) {
      return docId.matches(request.auth.uid + '(_.*)?');
    }
    // Phase 5: team data documents are sharded per category, so the id is
    // "{key}__{category}". The allowlists below name the KEY, not the shard.
    function baseKey(docId) {
      return docId.split('__')[0];
    }

    // ── Users (global; teamId assigned ONLY by the joinClub function) ──
    match /users/{uid} {
      // Own doc, superuser, or members of the same club.
      // Client list queries MUST use where('teamId','==',<own team>).
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || isSuperUser()
        || (resource.data.teamId != null && sameTeam(resource.data.teamId))
      );
      // Self-create without club/privilege/membership fields — joinClub writes
      // all of those server-side before the client ever gets here.
      allow create: if isSuperUser() || (
        request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['teamId', 'isTeamLead', 'isAdmin',
                                                 'roles', 'category', 'team',
                                                 'staffCategories', 'staffRole'])
      );
      allow update: if request.auth != null && (
        isSuperUser()
        // Self: any profile field EXCEPT club membership / privilege flags.
        // roles/category/team/staffCategories are NO LONGER self-writable:
        // membership is decided by the club's roster email lists and applied
        // server-side (joinClub / onRosterWritten / setRole). Leaving them
        // open made the registration gate bypassable from the console.
        // `staffRole` (coach | fitness | delegate) belongs in that list for
        // the same reason: the lead sets it on the roster doc, the server
        // re-derives it, and it is what the client's section gating reads.
        || (request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['teamId', 'isTeamLead', 'isAdmin', 'claimsUpdatedAt',
                          'roles', 'category', 'team', 'staffCategories',
                          'staffRole', 'prevCategory', 'prevTeam']))
        // Staff of the member's club: registration fields only. `roles` is not
        // here either — it only moves through the setRole callable, which keeps
        // the Auth claims in sync.
        // prevCategory/prevTeam remember the squad someone was taken out of,
        // so the Unassigned list can show where to put them back. Staff-owned
        // like the assignment itself; not self-writable, or a player could
        // fake a history.
        || (resource.data.teamId != null && isStaffOf(resource.data.teamId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['position', 'playerNumber', 'team', 'category',
                           'prevCategory', 'prevTeam',
                           'fitnessStatus', 'injuryNote']))
      );
      allow delete: if isSuperUser();

      match /tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Teams (all club data lives under teams/{teamId}) ──
    match /teams/{teamId} {
      allow read: if sameTeam(teamId) || isSuperUser();
      allow create, update: if isStaffOf(teamId) || isSuperUser();
      allow delete: if isSuperUser();

      // Blob/merge team-data docs. Availability/RPE moved wholly to the
      // record collections in Phase 3b — their frozen legacy docs are
      // staff-only now. Players may still write the keys their active
      // flows touch (injuries/notes/zone until the injuries record
      // collection lands; fa_users via the db.js reconcile +
      // deriveFitnessStatus; fa_staff_notifications via player alerts).
      // STAGE C: reads are scoped to the categories in the `cats` claim.
      // This is the line that finally makes category separation real —
      // before it, a cadet coach was merely not SHOWN juvenil's medical
      // records; the rules could not see inside a JSON blob to stop him
      // reading them. db.js queries where('category','in', scope), which
      // is what keeps this satisfiable: a collection query is rejected
      // outright if ANY document in it could be denied, so the query had
      // to narrow first (it did, in the same release).
      //
      // `none` holds staff accounts, unassigned players and pre-category
      // rows — every member needs it, so it is readable club-wide.
      // The `'cats' in token` guard keeps a session with an old token
      // denying rather than erroring, the same idiom the rosters rule uses.
      match /data/{key} {
        allow read: if isSuperUser()
          || (sameTeam(teamId) && 'cats' in request.auth.token
              && (resource.data.category == 'none'
                  || resource.data.category in request.auth.token.cats));
        allow write: if isSuperUser() || isStaffOf(teamId)
          || (sameTeam(teamId) && baseKey(key) in [
               'fa_injury_notes', 'fa_injury_zone', 'fa_injuries',
               'fa_users', 'fa_staff_notifications'
             ]);
      }

      // Per-record player-submitted data (canonical since Phase 2).
      // Players write ONLY records whose id starts with their uid and
      // whose uid field matches; staff/superuser manage everything.
      match /trainingAvail/{docId} {
        allow read: if sameTeam(teamId) || isSuperUser();
        allow create, update: if isSuperUser() || isStaffOf(teamId)
          || (sameTeam(teamId) && owns(docId)
              && request.resource.data.uid == request.auth.uid);
        allow delete: if isSuperUser() || isStaffOf(teamId)
          || (sameTeam(teamId) && owns(docId));
      }
      match /matchAvail/{docId} {
        allow read: if sameTeam(teamId) || isSuperUser();
        allow create, update: if isSuperUser() || isStaffOf(teamId)
          || (sameTeam(teamId) && owns(docId)
              && request.resource.data.uid == request.auth.uid);
        allow delete: if isSuperUser() || isStaffOf(teamId)
          || (sameTeam(teamId) && owns(docId));
      }
      match /rpe/{docId} {
        allow read: if sameTeam(teamId) || isSuperUser();
        allow create, update: if isSuperUser() || isStaffOf(teamId)
          || (sameTeam(teamId) && owns(docId)
              && request.resource.data.uid == request.auth.uid);
        allow delete: if isSuperUser() || isStaffOf(teamId)
          || (sameTeam(teamId) && owns(docId));
      }

      /* ── Coach match notes — the staff's own working document ──
         One doc per match: the pre-match plan, the post-match debrief, video
         LINKS, references to tactical boards, and the anada/tornada link.

         A SEPARATE COLLECTION, not another key under data/. That rule is
         scoped by category but NOT by role — it has to be, since players read
         their own squad's matches out of it — so a `fa_match_notes` shard
         would land on the phone of every player in the category. There is no
         way to make a blob under data/ staff-only without carving a key
         allowlist into a rule that is already the most load-bearing one in
         this file. Being outside data/ also keeps the notes out of js/db.js
         and js/shard.js entirely.

         Doc id is the match id (a NUMBER in fa_matches, so the client writes
         String(m.id)). Not `{uid}_{matchId}`: this is the staff's shared
         preparation for one match, not each coach's private diary, and
         owns(docId) would fragment one plan across whoever typed which half.

         `category` is duplicated onto the doc for the same reason every rule
         in this file duplicates ownerUid/clubId — so the check is
         self-contained and never needs a get() of fa_matches. It is immutable
         on update: letting it change would move a note between compartments
         without anyone in the new one having agreed.

         ⚠ THE SUB-ROLES ARE NOT VISIBLE HERE. coach, fitness and delegate all
         carry role:'staff' in the token; `staffRole` lives on users/{uid} and
         is not a claim. So this rule is STAFF-ONLY, hard, and "coach-only" is
         the client gate on top of it (js/app.js STAFF_ROLE_ACCESS), exactly
         as with the Pissarra page. Players are excluded by the rule; a
         delegate is excluded by the UI. Making the sub-role real means adding
         it to the claims — joinClub, setRole, onRosterWritten and this file. */
      match /matchNotes/{matchId} {
        allow read: if isSuperUser()
          || (isStaffOf(teamId) && 'cats' in request.auth.token
              && resource.data.category in request.auth.token.cats);
        allow create: if isSuperUser()
          || (isStaffOf(teamId) && 'cats' in request.auth.token
              && request.resource.data.category in request.auth.token.cats);
        allow update: if isSuperUser()
          || (isStaffOf(teamId) && 'cats' in request.auth.token
              && resource.data.category in request.auth.token.cats
              && request.resource.data.category == resource.data.category);
        allow delete: if isSuperUser()
          || (isStaffOf(teamId) && 'cats' in request.auth.token
              && resource.data.category in request.auth.token.cats);
      }

      match /seasons/{seasonId} {
        // The season doc itself is just a label and a timestamp.
        allow read: if sameTeam(teamId) || isSuperUser();
        allow write: if isSuperUser();

        /* Archived blob shards, scoped by category exactly like the LIVE
           data/ rule above. They were only `sameTeam`, so a coach who could
           not read a juvenil shard while the season was running could read
           the same shard — medical rows included — the moment it was
           archived. Archiving is not declassification.

           Archived shards keep both their {key}__{cat} id and their
           `category` field, so the live check applies verbatim. */
        match /data/{docId} {
          allow read: if isSuperUser()
            || (sameTeam(teamId) && 'cats' in request.auth.token
                && (resource.data.category == 'none'
                    || resource.data.category in request.auth.token.cats));
          allow write: if isSuperUser();
        }

        /* Per-record archives, ENUMERATED rather than a `/{archiveColl}/`
           wildcard, and that is load-bearing: overlapping match blocks are
           OR'd, never overridden. A wildcard here would also match
           seasons/{id}/data/* and hand back the club-wide read the block
           above just removed — the narrower rule would look right and do
           nothing. Listing them also fails CLOSED if a future archive
           collection appears.

           These stay club-wide readable: they carry no category field to
           test, and their live counterparts are club-wide too. Narrowing
           only the archived copy would be theatre. Tightening both together
           is the standing backlog item. */
        match /trainingAvail/{docId} {
          allow read: if sameTeam(teamId) || isSuperUser();
          allow write: if isSuperUser();
        }
        match /matchAvail/{docId} {
          allow read: if sameTeam(teamId) || isSuperUser();
          allow write: if isSuperUser();
        }
        match /rpe/{docId} {
          allow read: if sameTeam(teamId) || isSuperUser();
          allow write: if isSuperUser();
        }

        /* Archived coach notes. Unlike the three above, these are NOT
           club-wide readable: they carry a `category` and their live
           counterpart is staff-only, so the live check applies verbatim.
           Archiving is not declassification — the same principle the
           seasons/{id}/data block above was rewritten for. */
        match /matchNotes/{docId} {
          allow read: if isSuperUser()
            || (isStaffOf(teamId) && 'cats' in request.auth.token
                && resource.data.category in request.auth.token.cats);
          allow write: if isSuperUser();
        }
      }

      match /pushQueue/{docId} {
        allow create: if sameTeam(teamId);
        allow read, update, delete: if false;
      }
    }

    // ── Clubs (config readable by members only — the join code is NOT here) ──
    match /clubs/{clubId} {
      allow read: if sameTeam(clubId) || isSuperUser();
      allow create, delete: if isSuperUser();

      // The superadmin owns this document. `maxTeams` is a COMMERCIAL limit
      // on how many teams a lead may create, and `categories` is the thing it
      // limits — so neither is client-writable at all. Both go through the
      // setClubCategories callable, which is the only writer that can count
      // the teams before it commits. This rule used to be
      // `isSuperUser() || isLeadOf(clubId)` with no field allowlist, which
      // let a lead raise their own quota from a console in seconds.
      //
      // The fcfLinks/schedules clause is a BACK-COMPAT SHIM for APKs built
      // before v55, which still save team setup with a direct write. It is
      // safe because diff().affectedKeys() lists only the keys whose value
      // actually CHANGED: an old client sending an unchanged `categories`
      // map passes, and one adding or removing a letter does not. Drop this
      // clause once a v55+ APK has circulated.
      allow update: if isSuperUser()
                    || (isLeadOf(clubId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['fcfLinks', 'schedules']));

      /* Audit trail + resume point for deleteTeam. Written only by the
         Admin SDK, which bypasses rules entirely — `write: if false` is the
         point, not an oversight. The lead can read it to see that a delete
         ran, and when. */
      match /teamDeletions/{teamKey} {
        allow read: if isLeadOf(clubId) || isSuperUser();
        allow write: if false;
      }

      // ── Team rosters: the staff/player email lists (PII — minors' addresses).
      // Deliberately NOT on the club doc, which every member can read.
      // Doc id is "{category}-{letter}", the same key as fcfLinks/schedules.
      // Subcollections do NOT inherit the parent's rules — this match is what
      // makes them reachable at all.
      match /rosters/{teamKey} {
        function catOf() { return teamKey.split('-')[0]; }
        // Staff scoped to the category this doc belongs to. The `cats` claim is
        // always written by joinClub/setRole/onRosterWritten, but check it
        // exists so a pre-backfill token denies instead of erroring.
        function scopedStaff() {
          return isStaffOf(clubId)
            && 'cats' in request.auth.token
            && catOf() in request.auth.token.cats;
        }
        allow read: if isSuperUser() || isLeadOf(clubId) || scopedStaff();
        allow create, update, delete: if isSuperUser() || isLeadOf(clubId);
        // Staff may only ever touch playerEmails, and only in their own
        // categories. create and update are separate because `resource` is
        // null on create, so diff() would error there.
        allow create: if scopedStaff()
          && request.resource.data.keys().hasOnly(['playerEmails', 'updatedAt']);
        allow update: if scopedStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['playerEmails', 'updatedAt']);
      }
    }

    // ── Tactical boards ─────────────────────────────────────
    /* Two access paths, and only two:
         - the board's CLUB (any member: players see boards on the match and
           training detail pages, so this is not staff-only)
         - the CREATOR, wherever they are now. users/{uid}.teamId is
           single-valued, so a coach who moves club would otherwise lose every
           board they ever drew.

       There is deliberately NO category gate here, unlike teams/{id}/data.
       The thing that made data/ need one is minors' medical records; a board
       is a drawing of a formation and carries no personal data. That holds
       only while `linkedTeams` — which embeds player ids and names — stays on
       the SESSION reference in the category-sharded data/ collection and out
       of the payload. A unit test pins that, because a comment cannot.

       Metadata and payload are separate documents so listing a library does
       not download megabytes. They are written in ONE batch, and each rule is
       self-contained: ownerUid and clubId are duplicated onto the payload
       precisely so this block never needs a get() of its sibling — the same
       claims-only discipline as the rest of this file.

       clubId is a SCALAR and immutable. A board created in club A by a coach
       who later moves to B stays an A board; that is what requirement (c)
       asks for, and it answers "what stops a coach planting a board in
       someone else's library" by construction rather than by policing a list. */
    function boardIdentityUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.clubId == resource.data.clubId;
    }
    /* One-way adoption of an UNOWNED board. The migration cannot invent an
       author for a board that predates authorship, and a seeded template has
       none, so both land with ownerUid ''. Any staff of that club may claim
       one: '' -> me, inside my own club, never me -> anyone else. Without
       this, legacy boards would be permanently read-only, since update
       requires the owner arm. */
    function adoptsUnowned() {
      return resource.data.ownerUid == ''
          && isStaffOf(resource.data.clubId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.clubId == resource.data.clubId;
    }

    match /tacticBoards/{boardId} {
      allow read: if isSuperUser()
        || sameTeam(resource.data.clubId)
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if isSuperUser()
        || (isStaffOf(request.resource.data.clubId)
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.schema == 1);
      allow update: if isSuperUser()
        || (request.auth != null
            && resource.data.ownerUid == request.auth.uid
            && boardIdentityUnchanged())
        || adoptsUnowned();
      // The owner, or the LEAD of the board's club — a lead must be able to
      // prune the library of a coach who left. Leads may DELETE but not
      // UPDATE: pruning is governance, editing is authorship.
      allow delete: if isSuperUser()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || isLeadOf(resource.data.clubId);
    }

    match /tacticBoardData/{boardId} {
      allow read: if isSuperUser()
        || sameTeam(resource.data.clubId)
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if isSuperUser()
        || (isStaffOf(request.resource.data.clubId)
            && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isSuperUser()
        || (request.auth != null
            && resource.data.ownerUid == request.auth.uid
            && boardIdentityUnchanged())
        || adoptsUnowned();
      allow delete: if isSuperUser()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || isLeadOf(resource.data.clubId);
    }

    /* Denormalised author labels. A coach who left club A now has
       teamId == club B, so users/{uid} is unreadable by A — but A's library
       must still show who drew the board and for which team. Frozen on
       departure by simply not overwriting, rather than stamped onto every
       board: a coach changing category then costs ONE write, not N, and N is
       not even reachable (a departed coach's boards are writable by nobody
       but the owner).

       `write: if false` is the same idiom as clubs/{id}/teamDeletions — the
       Admin SDK bypasses rules, and client-writable would let a coach
       relabel themselves into a team they never coached. */
    match /clubs/{clubId}/boardAuthors/{uid} {
      allow read: if sameTeam(clubId) || isSuperUser();
      allow write: if false;
    }

    // ── Platform template library (superadmin-curated) ──────
    /* Anonymous by construction: promotion takes an independent COPY with the
       author and origin club stripped, so there is nothing here to
       compartmentalise and any signed-in user may browse. Seeding COPIES into
       a club rather than granting cross-club reads — a club must be able to
       edit and delete its own starter set without touching anyone else's. */
    match /tacticTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if isSuperUser();
    }
    match /tacticTemplateData/{templateId} {
      allow read: if request.auth != null;
      allow write: if isSuperUser();
    }

    /* Provenance: which club board a template was copied from, so the
       superadmin catalogue can mark a board it has already taken.

       It is a SEPARATE collection rather than a sourceBoardId field on the
       template because tacticTemplates is readable by every signed-in user,
       and "anonymous by construction" is the property that lets it be. A
       board id is not personal data, but a club learning that its board was
       promoted is not something the template doc should be able to say. */
    match /tacticTemplateSources/{boardId} {
      allow read, write: if isSuperUser();
    }

    // ── Club join codes: superuser + Cloud Functions only ──
    match /clubCodes/{code} {
      allow read, write: if isSuperUser();
    }

    // ── joinClub rate-limit counters: Cloud Functions only ──
    match /joinAttempts/{uid} {
      allow read, write: if false;
    }

    /* ── The referee database ────────────────────────────────────────────
       Built by the crawler in functions/index.js from what the federation
       publishes openly: who refereed a match, what the result was, and the
       sendings-off `sanciones` records. Nothing here is private, nothing is
       club-scoped, and there is no personal data beyond the officials' names
       — which fcf.cat prints on every match sheet.

       READ is for any signed-in user: a delegate opens a fixture and wants
       the referee's record in his own division. There is nothing to gate it
       on, and gating it per club would mean a copy per club of a table that
       is identical for everyone.

       WRITE is `false` for everybody, superuser included. The only writer is
       the Admin SDK inside the scheduled crawl, which bypasses rules
       entirely, and these are DERIVED documents: a hand edit would survive
       until the next rebuild and then vanish, which is worse than not being
       possible at all. */
    match /fcfReferees/{slug} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    /* The raw acta→referee index the profiles are rebuilt from. Readable for
       the same reason and just as un-writable; the app does not currently
       need it, but keeping it readable means a question the profiles cannot
       answer can be checked without a deploy. */
    match /fcfRefIndex/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    /* Crawl scope and cursor. NOT client-readable: the config decides how
       many requests get aimed at the federation's website, and the queue is a
       hundred-plus entries of machinery nobody's phone should download. */
    match /fcfCrawl/{docId} {
      allow read, write: if false;
    }
  }
}
