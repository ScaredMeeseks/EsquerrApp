rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures: readable by any signed-in user; writable ONLY by the
    // owner — filenames are {uid}.{ext}, enforced against the auth uid.
    //
    // create/update and delete are split deliberately. `request.resource` is
    // null on a delete, so the size/contentType checks below error out and
    // deny it — which previously meant NOBODY could delete a profile picture,
    // not even its owner. Changing a photo to a different file extension used
    // to strand the old file forever.
    match /profilePics/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                   && fileName.matches(request.auth.uid + '\\.[A-Za-z0-9]+')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Owner tidying up after themselves, or the superuser erasing a member.
      // The deleteMember function uses the Admin SDK and bypasses this.
      allow delete: if request.auth != null
                   && (fileName.matches(request.auth.uid + '\\.[A-Za-z0-9]+')
                       || request.auth.token.email == 'marna96@gmail.com');
    }

    // Club badges: superuser can write, anyone authenticated can read
    match /clubBadges/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'marna96@gmail.com'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Medical reports and scans (v234) ────────────────────────────────
    //
    // The most sensitive data in the app: a physio's ecography, a hospital
    // report, a photo of a scan. `Informes i proves` on the injury sheet.
    //
    // ⚠ THE CATEGORY IS IN THE PATH BECAUSE A STORAGE RULE CANNOT READ
    // FIRESTORE. There is nothing here to look the injury up in, so the
    // only thing the `cats` claim can be tested against is a path segment.
    // A file written under the wrong category would be readable by the
    // wrong coaches and invisible to the right ones — the client builds
    // this path from the PLAYER's category for that reason.
    //
    // ⚠ STAFF ONLY, INCLUDING READ. The player never sees these; the app
    // says so on the screen, and this is what makes it true rather than a
    // promise the UI keeps. `role in ['staff','lead']` mirrors isStaffOf()
    // in firestore.rules, and the `cats` test mirrors the category scoping
    // on teams/{teamId}/data — a coach reads only his own squads.
    //
    // ⚠ delete IS SPLIT OUT, for the same reason it is on profilePics:
    // `request.resource` is null on a delete, so a size or contentType
    // check in the same rule errors out and denies it. That once meant
    // nobody could delete a profile picture at all, not even its owner.
    match /medical/{teamId}/{category}/{injuryId}/{fileName} {
      function isMedStaff() {
        return request.auth != null
               && request.auth.token.teamId == teamId
               && request.auth.token.role in ['staff', 'lead']
               && category in request.auth.token.cats;
      }
      allow read: if isMedStaff()
                  || request.auth.token.email == 'marna96@gmail.com';
      allow create, update: if isMedStaff()
                   && request.resource.size < 10 * 1024 * 1024
                   // pdf, Word (both the 1997 and the OOXML type), or an
                   // image. Anything else is refused rather than stored and
                   // hoped about.
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf'
                       || request.resource.contentType == 'application/msword'
                       || request.resource.contentType ==
                          'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
      allow delete: if isMedStaff()
                    || request.auth.token.email == 'marna96@gmail.com';
    }
  }
}
